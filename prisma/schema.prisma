datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model Hotel {
  id                String            @id @default("rove_downtown_dubai")
  name              String
  brand             String
  address           String
  phoneReservations String
  phoneEvents       String
  emailGeneral      String
  emailEvents       String
  whatsappPrimary   String
  whatsappSecondary String?
  website           String
  checkinTime       String
  checkoutTime      String
  smokingPolicy     String
  petsAllowed       Boolean           @default(false)
  ecoCertification  String
  verified          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  rooms             Room[]
  facilities        Facility[]
  restaurants       Restaurant[]
  faqs              Faq[]
  policies          Policy[]
  amenities         Amenity[]
  offers            Offer[]
  events            Event[]
  attractions       Attraction[]
  transportOptions  TransportOption[]
  contacts          Contact[]
  documents         Document[]
  kbChunks          KbChunk[]
  meetingRooms      MeetingRoom[]
}

model Room {
  id           String   @id @default(uuid())
  roomId       String   @unique
  name         String
  sizeSqm      Float
  maxAdults    Int
  maxChildren  Int
  view         String
  keyFeatures  String
  description  String?
  pricingNote  String?
  bookingLink  String?
  verified     Boolean  @default(true)
  hotelId      String   @default("rove_downtown_dubai")
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Facility {
  id          String   @id @default(uuid())
  facilityId  String   @unique
  name        String
  category    String
  description String?
  hours       String?
  verified    Boolean  @default(true)
  hotelId     String   @default("rove_downtown_dubai")
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Restaurant {
  id             String     @id @default(uuid())
  outletId       String     @unique
  name           String
  type           String
  cuisine        String
  breakfastHours String?
  alcoholServed  Boolean    @default(true)
  description    String?
  menuLink       String?
  verified       Boolean    @default(true)
  hotelId        String     @default("rove_downtown_dubai")
  hotel          Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  menuNotes      MenuNote[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model MenuNote {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title        String
  content      String
  createdAt    DateTime   @default(now())
}

model MeetingRoom {
  id             String   @id @default(uuid())
  roomCode       String   @unique
  sizeSqm        Float?
  capacity       Int
  bestFor        String
  combinableWith String?
  verified       Boolean  @default(true)
  hotelId        String   @default("rove_downtown_dubai")
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String   @unique
  answer    String
  category  String
  verified  Boolean  @default(true)
  hotelId   String   @default("rove_downtown_dubai")
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Policy {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String
  verified  Boolean  @default(true)
  hotelId   String   @default("rove_downtown_dubai")
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Amenity {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String
  verified  Boolean  @default(true)
  hotelId   String   @default("rove_downtown_dubai")
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Offer {
  id          String   @id @default(uuid())
  title       String   @unique
  description String
  terms       String?
  verified    Boolean  @default(true)
  hotelId     String   @default("rove_downtown_dubai")
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String   @id @default(uuid())
  title       String   @unique
  type        String
  description String
  verified    Boolean  @default(true)
  hotelId     String   @default("rove_downtown_dubai")
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Attraction {
  id          String   @id @default(uuid())
  name        String   @unique
  distanceKm  Float
  timeMin     Int
  category    String
  description String?
  verified    Boolean  @default(true)
  hotelId     String   @default("rove_downtown_dubai")
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TransportOption {
  id         String   @id @default(uuid())
  mode       String
  name       String   @unique
  distanceKm Float?
  details    String?
  verified   Boolean  @default(true)
  hotelId    String   @default("rove_downtown_dubai")
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Contact {
  id        String   @id @default(uuid())
  channel   String
  detail    String   @unique
  source    String   @default("Official")
  verified  Boolean  @default(true)
  hotelId   String   @default("rove_downtown_dubai")
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(uuid())
  title     String
  fileName  String
  fileType  String
  filePath  String
  hotelId   String   @default("rove_downtown_dubai")
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model KbChunk {
  id        String                 @id @default(uuid())
  content   String
  category  String
  sourceUrl String?
  verified  Boolean                @default(true)
  embedding Unsupported("vector")?
  hotelId   String                 @default("rove_downtown_dubai")
  hotel     Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model Conversation {
  id        String    @id @default(uuid())
  sessionId String    @unique
  language  String    @default("en")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  role           String
  content        String
  sources        String?
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  feedbacks      Feedback[]
}

model Feedback {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String
  payload   Json
  timestamp DateTime @default(now())
}

model UnknownQuestion {
  id            String    @id @default(uuid())
  questionText  String    @unique
  occurredCount Int       @default(1)
  status        String    @default("new")
  adminAnswer   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
